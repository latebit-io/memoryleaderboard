{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latebit.io/memoryleaderboard/eval/fixture.schema.json",
  "title": "Local non-official AML native evaluation fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "records", "queries"],
  "properties": {
    "version": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/record"}
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/query"}
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "user_id", "session_id", "timestamp", "content"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"},
        "user_id": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1},
        "timestamp": {"type": "integer", "description": "Unix milliseconds"},
        "content": {"type": "string", "minLength": 1}
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "user_id", "scenario", "query", "relevant", "negative"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "user_id": {"type": "string", "minLength": 1},
        "scenario": {
          "enum": ["semantic", "temporal", "multi-hop", "distractor", "negative", "isolation"]
        },
        "query": {"type": "string", "minLength": 1},
        "relevant": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "negative": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "top_k": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    }
  }
}
