{
	email {$ACME_EMAIL}
	admin 127.0.0.1:2019
	http_port 8080
	https_port 8443
	servers {
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
	}
}

{$DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 8MB
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
	}

	reverse_proxy adapter:8080 {
		health_uri /healthz
		health_interval 10s
		health_timeout 5s
		transport http {
			dial_timeout 5s
			response_header_timeout 125s
		}
	}

	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers>X-Api-Key delete
			}
		}
	}
}
